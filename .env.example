# ---------- API ----------
DATABASE_URL=sqlite+aiosqlite:///./waddle.db
# JSON list. Use ["*"] for a fully public read-only API, or lock it to your site.
CORS_ORIGINS=["*"]

# ---------- Bot ----------
# Where the bot can reach the API
API_BASE_URL=http://127.0.0.1:8000
# Discord Developer Portal -> Bot -> Token (NEVER commit the real value)
DISCORD_TOKEN=
# Channel ID for the scheduled daily post (enable Developer Mode -> right-click channel -> Copy ID)
DISCORD_CHANNEL_ID=0
# Time of the daily broadcast, in UTC
DAILY_POST_HOUR_UTC=14
DAILY_POST_MINUTE_UTC=0
